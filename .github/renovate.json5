{
    ignorePaths: [
        ".archive/**"
    ],
    customManagers: [
        {
            customType: "jsonata",
            fileFormat: "yaml",
            managerFilePatterns: ["**/k0s-*-cluster.yaml"],
            matchStrings: ["spec.k0s.{\"currentValue\": version}"],
            depNameTemplate: "k0sproject/k0s",
            datasourceTemplate: "github-releases"
        },
        {
            customType: "jsonata",
            fileFormat: "yaml",
            managerFilePatterns: ["/(^|/)(.*-)?values(-prod|-test)?\\.ya?ml$/"],
            matchStrings: [
                "image.{\"depName\": name, \"currentValue\": tag}",
                "*.image.{\"depName\": name, \"currentValue\": tag}"
            ],
            datasourceTemplate: "docker"
        },
        {
          customType: "jsonata",
          fileFormat: "yaml",
          managerFilePatterns: ["/(^|/)apps/.+/(.*-)?app.yaml$/"],
          matchStrings: [
            "helm.( \
              $repo := $exists(repo) and $type(repo)='string' ? repo : 'oci://ghcr.io/lunarys/charts'; \
              $isHttp := $match($repo, /^https?:\\/\\//); \
              { \
                'datasource': ($isHttp ? 'helm' : 'docker'), \
                'depName': chart, \
                'currentValue': version, \
                'registryUrl': ($isHttp ? $repo : undefined), \
                'packageName': ($isHttp ? chart : ($substringAfter($repo, 'oci://') & '/' & chart)) \
              } \
            )"
          ]
        },
        {
            customType: "jsonata",
            fileFormat: "yaml",
            managerFilePatterns: ["03_apps/values.yaml"],
            matchStrings: [
                "{\"currentValue\": secretsChartVersion, \"packageName\": $substringAfter(mainHelmRepo, 'oci://') & '/' & secretsChart, 'depName': secretsChart}"
            ],
            datasourceTemplate: "docker"
        },
        {
            customType: "jsonata",
            fileFormat: "yaml",
            managerFilePatterns: ["03_apps/values.yaml"],
            matchStrings: [
                "{\"currentValue\": networkPolicyChartVersion, \"packageName\": $substringAfter(mainHelmRepo, 'oci://') & '/' & networkPolicyChart, 'depName': networkPolicyChart}"
            ],
            datasourceTemplate: "docker"
        }
    ],
    "packageRules": [
        {
            "matchManagers": ["github-actions"],
            "groupName": "GitHub Actions"
        },
        {
            // n8n publishes its beta line to the registry as plain semver tags
            // (next/beta -> 2.36.x while stable -> 2.35.x), so the docker
            // datasource can't tell them apart. GitHub marks those releases as
            // prereleases, so look versions up there instead and let the default
            // ignoreUnstable filter them out. Release tags are "n8n@<version>".
            "matchPackageNames": ["docker.n8n.io/n8nio/n8n", "ghcr.io/n8n-io/n8n"],
            "overrideDatasource": "github-releases",
            "overridePackageName": "n8n-io/n8n",
            "extractVersion": "^n8n@(?<version>.+)$"
        },
        {
            // Helm datasource doesn't expose the chart's source repo, so point
            // Renovate at the upstream GitHub repo for changelogs/release notes.
            "matchDatasources": ["helm"],
            "matchPackageNames": ["csi-driver-smb"],
            "sourceUrl": "https://github.com/kubernetes-csi/csi-driver-smb"
        }
    ]
}
