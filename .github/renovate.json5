{
    ignorePaths: [
        ".archive/**"
    ],
    customManagers: [
        {
            customType: "jsonata",
            fileFormat: "yaml",
            managerFilePatterns: ["**/k0s-*-cluster.yaml"],
            matchStrings: ["spec.k0s.{\"currentValue\": version}"],
            depNameTemplate: "k0sproject/k0s",
            datasourceTemplate: "github-releases"
        },
        {
            customType: "jsonata",
            fileFormat: "yaml",
            managerFilePatterns: ["/(^|/)(.*-)?values(-prod|-test)?\\.ya?ml$/"],
            // Renovate parses YAML as a list of documents, so these run against
            // [doc], not doc. A named first step (`image`) maps over that list
            // on its own; a leading wildcard does not -- `*.image` matches
            // nothing against [doc] -- so `$.` anchors it. The second form is
            // the one that matters now: every Chart.yaml wrapper nests its
            // values under the dependency alias (`<alias>.image`).
            matchStrings: [
                "image.{\"depName\": name, \"currentValue\": tag}",
                "$.*.image.{\"depName\": name, \"currentValue\": tag}"
            ],
            datasourceTemplate: "docker"
        }
    ],
    "packageRules": [
        {
            "matchManagers": ["github-actions"],
            "groupName": "GitHub Actions"
        },
        {
            // n8n publishes its beta line to the registry as plain semver tags
            // (next/beta -> 2.36.x while stable -> 2.35.x), so the docker
            // datasource can't tell them apart. GitHub marks those releases as
            // prereleases, so look versions up there instead and let the default
            // ignoreUnstable filter them out. Release tags are "n8n@<version>".
            "matchPackageNames": ["docker.n8n.io/n8nio/n8n", "ghcr.io/n8n-io/n8n"],
            "overrideDatasource": "github-releases",
            "overridePackageName": "n8n-io/n8n",
            "extractVersion": "^n8n@(?<version>.+)$"
        },
        {
            // Helm datasource doesn't expose the chart's source repo, so point
            // Renovate at the upstream GitHub repo for changelogs/release notes.
            "matchDatasources": ["helm"],
            "matchPackageNames": ["csi-driver-smb"],
            "sourceUrl": "https://github.com/kubernetes-csi/csi-driver-smb"
        }
    ]
}
